<?xml version="1.0" encoding="UTF-8"?>
<project name="CyntexaDemo-Git" default="main" basedir=".">

    <!-- Debug and Validation Target -->
    <target name="check-params">
        <echo message="=================================================="/>
        <echo message="[DEBUG] Received build.version = '${build.version}'"/>
        <echo message="=================================================="/>

        <condition property="invalidParameter">
            <or>
                <equals arg1="${build.version}" arg2="MUST_OVERRIDE" />
                <equals arg1="${build.version}" arg2="$${build.version}" />
                <not>
                    <isset property="build.version" />
                </not>
            </or>
        </condition>

        <fail if="invalidParameter" message="ERROR: The 'build.version' parameter was NOT provided or overridden in the API request payload!" />
    </target>

    <!-- Execution Targets mapped to validation -->
    <target name="main" depends="check-params">
        <echo message="[GIT BUILD] Parameter validation passed! build.version = ${build.version}"/>
    </target>

    <target name="build" depends="check-params">
        <echo message="[GIT BUILD] Parameter validation passed! build.version = ${build.version}"/>
    </target>

    <target name="compile" depends="check-params">
        <echo message="[GIT BUILD] Parameter validation passed! build.version = ${build.version}"/>
    </target>

</project>
