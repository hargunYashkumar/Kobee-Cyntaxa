<?xml version="1.0" encoding="UTF-8"?>
<project name="CyntexaDemo" default="main" basedir=".">
    
    <target name="check-params">
        <!-- Check if the value is still the default Kobee value -->
        <condition property="parameterNotProvided">
            <equals arg1="${build.version}" arg2="MUST_OVERRIDE" />
        </condition>
        
        <!-- Fail the build if the condition is true -->
        <fail if="parameterNotProvided" message="ERROR: The 'build.version' parameter was NOT provided in the API request payload!" />
    </target>

    <target name="main" depends="check-params" description="Main build target">
        <echo message="Success! The parameter build.version is successfully overridden to: ${build.version}"/>
        <echo message="Kobee ITS integration active."/>
    </target>

</project>
